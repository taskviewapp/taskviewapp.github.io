<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Refund Policy — Task View</title>
  <meta name="theme-color" content="#0f0b2e">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f7f5ff; color: #1a1035; }

    .hero {
      background: #0f0b2e;
      padding: 52px 32px 80px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .glow-orb { position: absolute; border-radius: 50%; filter: blur(60px); opacity: 0.3; pointer-events: none; }
    .glow-orb.amber { width: 280px; height: 280px; background: #f5a623; top: -60px; right: 10%; }
    .glow-orb.purple { width: 300px; height: 300px; background: #7c3aed; bottom: -80px; left: 15%; }
    .hero::after {
      content: '';
      position: absolute;
      bottom: -44px; left: 0; right: 0;
      height: 88px;
      background: #f7f5ff;
      border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    }
    .hero-inner { position: relative; z-index: 1; }
    .hero-logo { display: inline-block; margin-bottom: 20px; }
    .hero-logo img { width: 56px; height: 56px; border-radius: 14px; display: block; }
    .hero-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: rgba(255,255,255,0.6);
      text-decoration: none;
      font-size: 13px;
      margin-bottom: 20px;
    }
    .hero-back:hover { color: #fff; }
    .hero h1 { font-size: 28px; font-weight: 800; color: #fff; margin-bottom: 8px; }
    .hero h1 span {
      background: linear-gradient(90deg, #ff6b3d, #f5a623);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .hero .meta { font-size: 13px; color: rgba(255,255,255,0.45); margin-top: 8px; }

    .summary-box {
      max-width: 720px;
      margin: 52px auto 0;
      padding: 0 24px;
    }
    .summary-inner {
      background: #fff;
      border: 1px solid #e8e0ff;
      border-left: 4px solid #ff6b3d;
      border-radius: 0 12px 12px 0;
      padding: 20px 24px;
      font-size: 15px;
      line-height: 1.7;
      color: #1a1035;
    }
    .summary-inner strong { color: #ff6b3d; }

    .content {
      max-width: 720px;
      margin: 0 auto;
      padding: 32px 24px 80px;
    }
    h2 {
      font-size: 18px;
      font-weight: 700;
      color: #1a1035;
      margin: 40px 0 12px;
      padding-bottom: 8px;
      border-bottom: 2px solid #e8e0ff;
    }
    h3 { font-size: 15px; font-weight: 600; color: #7c3aed; margin: 24px 0 8px; }
    p { font-size: 15px; line-height: 1.75; color: #1a1035; margin-bottom: 14px; }
    ul { margin: 8px 0 14px 24px; }
    ul li { font-size: 15px; line-height: 1.75; color: #1a1035; margin-bottom: 6px; }
    ol { margin: 8px 0 14px 24px; }
    ol li { font-size: 15px; line-height: 1.75; color: #1a1035; margin-bottom: 6px; }
    a { color: #7c3aed; text-decoration: none; }
    a:hover { text-decoration: underline; }
    strong { font-weight: 600; }

    .platform-block {
      background: #fff;
      border: 1px solid #e8e0ff;
      border-radius: 12px;
      padding: 20px 24px;
      margin: 16px 0;
    }

    footer {
      background: #0f0b2e;
      padding: 32px 24px;
      text-align: center;
    }
    footer p { font-size: 13px; color: rgba(255,255,255,0.45); margin-bottom: 12px; line-height: 1.7; }
    footer a { color: rgba(255,255,255,0.6); text-decoration: none; margin: 0 12px; font-size: 13px; }
    footer a:hover { color: #fff; }
